DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meu_barbeiro
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
# URL pública usada nos links de agendamento e convites (padrão: FRONTEND_URL)
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333
DEFAULT_BARBERSHOP_SLUG=barbearia-central

# Origens permitidas no CORS, separadas por vírgula. Padrão: FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173
# `false` quando a API é exposta sem proxy reverso.
TRUST_PROXY=1
# debug | info | warn | error
LOG_LEVEL=info
APP_VERSION=1.2.0
GIT_COMMIT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=
# Opt-in: evita envios acidentais em desenvolvimento e testes.
REMINDERS_ENABLED=false

# Convites de equipe. Sem provedor configurado o convite é criado e o link
# aparece na resposta da API (útil para copiar e enviar manualmente).
RESEND_API_KEY=
EMAIL_FROM=Meu Barbeiro <nao-responda@meubarbeiro.app>
EMAIL_WEBHOOK_URL=

# Aplicação Mercado Pago: credenciais de teste no sandbox, produção no ambiente produtivo.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=

# 32 bytes em base64. Exemplo de geração: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Administrador da plataforma: aprova quem pode cadastrar um estabelecimento.
# Em produção a senha é obrigatória (mín. 12 caracteres). Rotacione trocando o valor e reiniciando a API.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
