datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  BARBER
  CUSTOMER
}

enum MembershipRole {
  OWNER
  ADMIN
  BARBER
}

enum DepositType {
  NONE
  PERCENTAGE
  FIXED
  FULL
}

enum SubscriptionStatus {
  INACTIVE
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String?           @unique
  googleId           String?           @unique
  phone              String?           @unique
  telegramId         String?           @unique
  role               Role              @default(CUSTOMER)
  appointments       Appointment[]     @relation("UserAppointments")
  barberAppointments Appointment[]     @relation("BarberAppointments")
  productSales       ProductSale[]
  memberships        Membership[]
  barberAbsences     BarberAbsence[]
  barberSchedules    BarberSchedule[]
  customerProfiles   CustomerProfile[] @relation("CustomerProfiles")
  updatedProfiles    CustomerProfile[] @relation("CustomerProfileUpdates")
  loyaltyStamps      LoyaltyStamp[]
  receivedReminders  AppointmentReminder[] @relation("ReminderRecipient")
  cancellations      AppointmentCancellation[] @relation("CancellationActor")
  walkInQueueEntries WalkInQueue[]       @relation("WalkInQueueCustomer")
  preferredWalkIns   WalkInQueue[]       @relation("WalkInQueueBarber")
  customerSubscriptions CustomerSubscription[]
  recurringBookings    RecurringBooking[]       @relation("RecurringBookingCustomer")
  barberRecurringBookings RecurringBooking[]    @relation("RecurringBookingBarber")
  createdAt          DateTime          @default(now())
}

model Barbershop {
  id                               String             @id @default(uuid())
  slug                             String             @unique
  name                             String
  logoUrl                          String?
  primaryColor                     String             @default("#d99b32")
  address                          String?
  timezone                         String             @default("America/Sao_Paulo")
  depositType                      DepositType        @default(FULL)
  depositValue                     Int                @default(0)
  monthlyFeeCents                  Int                @default(2000)
  commissionBps                    Int                @default(100)
  subscriptionStatus               SubscriptionStatus @default(INACTIVE)
  mercadoPagoSubscriptionId        String?            @unique
  mercadoPagoSellerId              String?            @unique
  mercadoPagoAccessTokenEncrypted  String?
  mercadoPagoRefreshTokenEncrypted String?
  mercadoPagoTokenExpiresAt        DateTime?
  memberships                      Membership[]
  businessHours                    BusinessHour[]
  services                         Service[]
  products                         Product[]
  productSales                     ProductSale[]
  holidays                         Holiday[]
  barberAbsences                   BarberAbsence[]
  barberSchedules                  BarberSchedule[]
  appointments                     Appointment[]
  customerProfiles                 CustomerProfile[]
  loyaltyProgram                   LoyaltyProgram?
  loyaltyStamps                    LoyaltyStamp[]
  appointmentReminders             AppointmentReminder[]
  appointmentCancellations         AppointmentCancellation[]
  walkInQueue                      WalkInQueue[]
  membershipPlans                 MembershipPlan[]
  customerSubscriptions           CustomerSubscription[]
  recurringBookings               RecurringBooking[]
  recurringBookingOccurrences     RecurringBookingOccurrence[]
  cancellationWindowHours          Int                @default(0)
  lateCancellationFeeBps           Int                @default(0)
  remindersEnabled                 Boolean            @default(true)
  reminderHoursBefore              Int[]              @default([24, 2])
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @default(now()) @updatedAt
}

model Membership {
  id                 String         @id @default(uuid())
  barbershopId       String
  userId             String
  role               MembershipRole
  notificationTypes  String[]       @default(["NEW_APPOINTMENT", "CANCELLATION", "RESCHEDULE", "NO_SHOW", "DAILY_SUMMARY"])
  dailySummaryTime   String         @default("07:00")
  barbershop         Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, userId])
  @@index([userId])
}

model BusinessHour {
  id            String     @id @default(uuid())
  barbershopId  String
  weekday       Int
  opensAt       String
  closesAt      String
  breakStartsAt String?
  breakEndsAt   String?
  enabled       Boolean    @default(true)
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, weekday])
}

model BarberAbsence {
  id           String     @id @default(uuid())
  barbershopId String
  barberId     String
  startsAt     DateTime
  endsAt       DateTime
  reason       String
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       User       @relation(fields: [barberId], references: [id])

  @@index([barbershopId, barberId, startsAt])
}

model BarberSchedule {
  id           String     @id @default(uuid())
  barbershopId String
  barberId     String
  weekday      Int
  startsAt     String
  endsAt       String
  enabled      Boolean    @default(true)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       User       @relation(fields: [barberId], references: [id])

  @@unique([barbershopId, barberId, weekday])
}

model Service {
  id           String        @id @default(uuid())
  barbershopId String
  name         String
  duration     Int
  priceCents   Int
  active       Boolean       @default(true)
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([barbershopId, name])
  @@unique([barbershopId, id])
  @@index([barbershopId])
}

model CustomerProfile {
  id           String     @id @default(uuid())
  barbershopId String
  userId       String
  preferences  String?
  notes        String?
  allergies    String?
  updatedAt    DateTime   @updatedAt
  updatedById  String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User       @relation("CustomerProfiles", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy    User       @relation("CustomerProfileUpdates", fields: [updatedById], references: [id])

  @@unique([barbershopId, userId])
  @@index([userId])
}

model Product {
  id            String        @id @default(uuid())
  barbershopId  String
  name          String
  priceCents    Int
  stockQuantity Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  barbershop    Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  sales         ProductSale[]

  @@unique([barbershopId, name])
  @@unique([barbershopId, id])
  @@index([barbershopId])
}

model ProductSale {
  id             String       @id @default(uuid())
  barbershopId   String
  productId      String
  quantity       Int
  unitPriceCents Int
  soldById       String
  appointmentId  String?
  createdAt      DateTime     @default(now())
  barbershop     Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [barbershopId, productId], references: [barbershopId, id], map: "ProductSale_product_tenant_fkey")
  soldBy         User         @relation(fields: [soldById], references: [id])
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([barbershopId])
  @@index([productId])
}

model Holiday {
  id           String     @id @default(uuid())
  barbershopId String
  date         DateTime   @db.Date
  description  String
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, date])
}

model Appointment {
  id                      String        @id @default(uuid())
  barbershopId            String
  userId                  String
  barberId                String
  serviceId               String
  scheduledAt             DateTime
  status                  String        @default("PENDING")
  paymentStatus           PaymentStatus @default(NOT_REQUIRED)
  paymentAmountCents      Int           @default(0)
  commissionCents         Int           @default(0)
  paymentExpiresAt        DateTime?
  mercadoPagoPreferenceId String?       @unique
  mercadoPagoPaymentId    String?       @unique
  customerConfirmedAt     DateTime?
  walkInQueueId           String?
  customerSubscriptionId  String?
  recurringBookingId      String?

  barbershop   Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User                  @relation("UserAppointments", fields: [userId], references: [id])
  barber       User                  @relation("BarberAppointments", fields: [barberId], references: [id])
  service      Service               @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], map: "Appointment_service_tenant_fkey")
  productSales ProductSale[]
  reminders    AppointmentReminder[]
  loyaltyStamp LoyaltyStamp?
  cancellation AppointmentCancellation?
  walkInQueue  WalkInQueue?           @relation(fields: [walkInQueueId], references: [id], onDelete: SetNull)
  customerSubscription CustomerSubscription? @relation(fields: [customerSubscriptionId], references: [id], onDelete: SetNull)
  recurringBooking     RecurringBooking?     @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  recurringOccurrence  RecurringBookingOccurrence?
  createdAt    DateTime              @default(now())

  @@index([barbershopId, barberId, scheduledAt])
  @@index([barbershopId, userId])
  @@index([walkInQueueId])
  @@index([customerSubscriptionId])
  @@index([recurringBookingId])
}

model MembershipPlan {
  id             String   @id @default(uuid())
  barbershopId   String
  name           String
  priceCents     Int
  intervalDays   Int
  includedVisits Int
  serviceIds     String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  subscriptions  CustomerSubscription[]

  @@unique([barbershopId, name])
  @@index([barbershopId, active])
}

model CustomerSubscription {
  id                          String   @id @default(uuid())
  barbershopId                String
  userId                      String
  planId                      String
  status                      String   @default("ACTIVE")
  startedAt                   DateTime @default(now())
  currentPeriodStart          DateTime
  currentPeriodEnd            DateTime
  visitsUsed                  Int      @default(0)
  mercadoPagoSubscriptionId   String?  @unique
  cancelledAt                 DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  barbershop                  Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user                        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                        MembershipPlan @relation(fields: [planId], references: [id])
  appointments                Appointment[]
  recurringBookings           RecurringBooking[]

  @@index([barbershopId, status])
  @@index([userId, status])
  @@index([planId])
}

model RecurringBooking {
  id             String   @id @default(uuid())
  barbershopId   String
  subscriptionId String
  userId         String
  barberId       String
  serviceIds     String[]
  weekday        Int
  time           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User @relation("RecurringBookingCustomer", fields: [userId], references: [id], onDelete: Cascade)
  barber         User @relation("RecurringBookingBarber", fields: [barberId], references: [id])
  appointments   Appointment[]
  occurrences    RecurringBookingOccurrence[]

  @@index([barbershopId, active])
  @@index([subscriptionId])
  @@index([userId])
  @@index([barberId])
}

model RecurringBookingOccurrence {
  id                 String   @id @default(uuid())
  barbershopId       String
  recurringBookingId String
  scheduledAt        DateTime
  status             String
  reason             String?
  appointmentId      String?  @unique
  createdAt          DateTime @default(now())
  barbershop         Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  recurringBooking   RecurringBooking @relation(fields: [recurringBookingId], references: [id], onDelete: Cascade)
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([recurringBookingId, scheduledAt])
  @@index([barbershopId, status, scheduledAt])
}

model WalkInQueue {
  id               String     @id @default(uuid())
  barbershopId     String
  userId           String?
  guestName        String?
  serviceIds       String[]
  barberId         String?
  status           String     @default("WAITING")
  arrivedAt        DateTime   @default(now())
  calledAt         DateTime?
  finishedAt       DateTime?
  estimatedMinutes Int?
  createdAt        DateTime   @default(now())
  barbershop       Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user             User?      @relation("WalkInQueueCustomer", fields: [userId], references: [id], onDelete: SetNull)
  barber           User?      @relation("WalkInQueueBarber", fields: [barberId], references: [id], onDelete: SetNull)
  appointments     Appointment[]

  @@index([barbershopId, arrivedAt])
  @@index([barbershopId, status, arrivedAt])
  @@index([userId, status])
}

model AppointmentCancellation {
  id              String      @id @default(uuid())
  appointmentId   String      @unique
  barbershopId    String
  cancelledById   String
  cancelledByRole String
  reason          String?
  hoursBefore     Int
  refundedCents   Int
  feeCents        Int
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barbershop      Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  cancelledBy     User        @relation("CancellationActor", fields: [cancelledById], references: [id])

  @@index([barbershopId, createdAt])
  @@index([cancelledById])
}

model LoyaltyProgram {
  id                String     @id @default(uuid())
  barbershopId      String     @unique
  enabled           Boolean    @default(false)
  requiredVisits    Int        @default(10)
  rewardDescription String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  barbershop        Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}

model LoyaltyStamp {
  id            String      @id @default(uuid())
  barbershopId  String
  userId        String
  appointmentId String      @unique
  redeemedAt    DateTime?
  createdAt     DateTime    @default(now())
  barbershop    Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([barbershopId, userId, redeemedAt])
}

model AppointmentReminder {
  id               String       @id @default(uuid())
  appointmentId    String?
  recipientId      String
  barbershopId     String
  kind             String
  channel          String       @default("telegram")
  deduplicationKey String       @unique
  message          String?
  availableAt      DateTime     @default(now())
  sentAt           DateTime     @default(now())
  processedAt      DateTime?
  deliveredOk      Boolean      @default(false)
  error            String?
  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipient        User         @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  barbershop       Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([recipientId, processedAt, availableAt])
  @@index([barbershopId])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model Session {
  sid       String   @id
  data      Json
  expiresAt DateTime

  @@index([expiresAt])
}
