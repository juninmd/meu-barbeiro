{
  "name": "meu-barbeiro",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:full": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:report": "pnpm --filter web test:e2e:report"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "qs": "6.15.2"
    }
  }
}
