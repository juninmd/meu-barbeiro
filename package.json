{
  "name": "meu-barbeiro",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:full": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:report": "pnpm --filter web test:e2e:report"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "qs": "6.15.2",
      "axios@1.16.0": ">=1.20.0 <2.0.0",
      "body-parser@2.2.2": ">=2.4.0 <3.0.0",
      "follow-redirects@1.16.0": ">=1.16.2 <2.0.0",
      "proxy-addr@2.0.7": ">=2.0.8 <3.0.0",
      "react-router@7.18.1": ">=7.18.2 <8.0.0"
    }
  }
}
