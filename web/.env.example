# API usada em build/produção. Em desenvolvimento mock, nenhuma API é necessária.
VITE_API_URL=http://localhost:3333

# O mock só pode ser ativado por `vite dev`. Use false para testar a API real localmente.
VITE_ENABLE_MOCKS=true

# Slug usado quando a URL não estiver no formato /b/{slug}.
VITE_BARBERSHOP_SLUG=barbearia-central
